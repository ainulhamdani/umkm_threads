# HTTP
PORT=3000
PUBLIC_APP_URL=http://localhost:3000

# MySQL used by the local XAMPP service at D:\xampp\mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=threads_shop
DB_USER=root
DB_PASSWORD=

# Legacy local uploads. New uploads use PictShare.
UPLOAD_DIR=storage/uploads
MAX_IMAGE_BYTES=5242880

# PictShare v2 image service. The API URL can be the private CapRover hostname.
PICTSHARE_API_URL=http://srv-captain--pictshare:80
PICTSHARE_PUBLIC_URL=https://images.example.com
PICTSHARE_UPLOAD_CODE=
PICTSHARE_TIMEOUT_MS=30000

# The first superadmin is provisioned only by the seed command.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-password
