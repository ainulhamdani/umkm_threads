# HTTP
PORT=3000
PUBLIC_APP_URL=http://localhost:3000

# MySQL used by the local XAMPP service at D:\xampp\mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=threads_shop
DB_USER=root
DB_PASSWORD=

# Uploads
UPLOAD_DIR=storage/uploads
MAX_IMAGE_BYTES=5242880

# The first superadmin is provisioned only by the seed command.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-password
